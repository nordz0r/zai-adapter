# Скопируй в .env рядом с docker-compose.yml и заполни.
# Ключ coding plan: dd:/root/.zcode/cli/config.json -> provider.zai.options.apiKey
# (формат <id>.<secret>), либо свой ключ с z.ai Open Platform.
ZAI_API_KEY=

# Ключ защиты самого адаптера; генерация:
#   python3 -c "import secrets;print(secrets.token_hex(24))"
# Оставь пустым, чтобы отключить аутентификацию endpoint'а.
ADAPTER_API_KEY=

# Порт наружу на хосте (внутри контейнера всегда 8100).
# ZAI_ADAPTER_PORT=8100

# Модель по умолчанию, если клиент не указал model.
# ZAI_DEFAULT_MODEL=glm-5.3-flash
